[resource]
default_font = SubResource("SystemFont_main")
default_font_size = 18
Button/colors/font_color = Color(0.88, 0.94, 1, 1)
Button/colors/font_hover_color = Color(1, 0.96, 0.8, 1)
Button/colors/font_pressed_color = Color(1, 1, 1, 1)
